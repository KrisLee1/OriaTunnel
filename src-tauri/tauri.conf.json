{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OriaTunnel",
  "version": "0.1.1",
  "identifier": "com.oria-tunnel",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OriaTunnel",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "acceptFirstMouse": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMkVEOTY4MzJERURCOUMKUldTYzI5NHlhTmt1cnRRaFRlUGczcWFRd2U3UG9nTE1SR2ErWUJ2RzN5MWNvUEU3aHVWeEVvK2oK",
      "endpoints": ["https://github.com/KrisLee1/OriaTunnel/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": false,
    "licenseFile": "../LICENSE",
    "resources": { "../LICENSE": "licenses/OriaTunnel_GPL-3.0.txt", "../docs/licenses/xtermjs.txt": "licenses/xtermjs.txt", "../docs/licenses/DSH_MIT.txt": "licenses/DSH_MIT.txt", "../docs/licenses/SIMPLE_ICONS_CC0-1.0.txt": "licenses/SIMPLE_ICONS_CC0-1.0.txt", "../docs/licenses/APACHE-2.0.txt": "licenses/APACHE-2.0.txt", "../docs/licenses/BROWSER_LOGOS_MIT.txt": "licenses/BROWSER_LOGOS_MIT.txt", "../docs/licenses/FIREFOX_MPL_2_0.txt": "licenses/FIREFOX_MPL_2_0.txt" },
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
