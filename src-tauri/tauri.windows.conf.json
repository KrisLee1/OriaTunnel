{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/installer-icon.ico",
        "compression": "zlib",
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "German",
          "French",
          "Russian"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
