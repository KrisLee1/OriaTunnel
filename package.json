    "@oriatheme/tailwind": "^0.1.0",
    "@shadcn/react": "^0.3.0",
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.10.1",
